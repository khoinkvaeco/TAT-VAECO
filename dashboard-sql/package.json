{
  "name": "dashboard-sql-tat",
  "version": "1.0.0",
  "description": "Web Dashboard bao cao TAT (Turn-Around-Time) doc du lieu tu SQL Server (AMOS/NQT)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "service:install": "node service-install.js",
    "service:uninstall": "node service-uninstall.js",
    "smoke": "node tools/smoke.js && node tools/sqlcheck.js && node tools/gatecheck.js && node tools/loadcheck.js && node tools/snapcheck.js && node tools/chatcheck.js && node tools/build-assets.js --check",
    "sqlcheck": "node tools/sqlcheck.js",
    "build:assets": "node tools/build-assets.js",
    "gatecheck": "node tools/gatecheck.js",
    "loadcheck": "node tools/loadcheck.js",
    "snapcheck": "node tools/snapcheck.js",
    "chatcheck": "node tools/chatcheck.js"
  },
  "keywords": [
    "dashboard",
    "tat",
    "sql-server",
    "mssql",
    "express",
    "amos"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "mssql": "^11.0.1"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.114.0",
    "node-windows": "1.0.0-beta.8"
  },
  "devDependencies": {
    "chart.js": "^4.4.1",
    "tabulator-tables": "^6.2.1",
    "tailwindcss": "^3.4.16",
    "xlsx": "^0.18.5"
  }
}
