# ==========================================================================
#  CAU HINH KET NOI SQL SERVER  (copy file nay thanh ".env" roi dien thong tin)
#  KHONG commit file .env that len git!
# ==========================================================================

# --- Thong tin dang nhap SQL Server ---
DB_USER=sa
DB_PASSWORD=your_password_here
DB_SERVER=localhost
# Database mac dinh khi ket noi (queries van fully-qualified [NQT]./[DWH_DB]..
# nen tai khoan can co quyen doc ca 2 database NQT va DWH_DB)
DB_DATABASE=NQT
DB_PORT=1433

# --- Tuy chon driver ---
# encrypt=true neu SQL Server yeu cau ma hoa (Azure SQL bat buoc true)
DB_ENCRYPT=false
# trustServerCertificate=true khi dung self-signed cert trong LAN noi bo
DB_TRUST_SERVER_CERTIFICATE=true
# Ten instance neu dung named instance (vd: SQLEXPRESS). De trong neu khong dung.
DB_INSTANCE=

# --- Ung dung ---
# Cong cua web server
PORT=3000
# So dong toi da tra ve moi query chi tiet (gioi han an toan bo nho).
# San toi thieu 1000 (dat nho hon se tu nang len 1000). KPI/bieu do KHONG bi
# anh huong boi gioi han nay (tinh bang AVG/COUNT tren toan bo du lieu).
MAX_ROWS=20000
# Chenh lech gio giua AMOS va gio Viet Nam (AMOS luu UTC => +7)
AMOS_TZ_OFFSET_HOURS=7
# Moc (epoch) cua cot ngay AMOS: mutation = SO NGAY ke tu ngay nay.
# Da xac dinh: hom nay 2026-07-08 = AMOS 19913 -> epoch = 1971-12-31.
AMOS_DATE_EPOCH=1971-12-31

# --- Thu muc luu DU LIEU DO NGUOI DUNG TAO ---
# Gom: cap doi ung thu cong (reconcile-manual.json), kho tri thuc chatbot da hoc
# (kb-learned.json), trang thai bao cao dinh ky. KHONG ghi vao SQL Server -> tai
# khoan DB chi can quyen DOC.
# De TRONG = luu trong thu muc app (dashboard-sql/data) -> CAI LAI hoac GHI DE
# app co the LAM MAT du lieu. NEN tro ra thu muc RIENG ben ngoai:
#   DATA_DIR=D:\VAECO\dashboard-data
# Tai khoan chay service phai co quyen GHI vao thu muc nay.
# Moi lan ghi deu tu giu ban cu (.bak) va ghi nguyen tu (.tmp -> doi ten).
DATA_DIR=

# --- Cache bang SIGN (tang toc, bo truy van linked server Oracle moi query) ---
# App tu tao bang [NQT].[dbo].[SIGN_CACHE] va lam moi dinh ky tu
# [DWH_DB]..[STG_AMOS].[SIGN] (can quyen CREATE TABLE tren NQT; neu khong co
# quyen, app tu fallback ve join linked server truc tiep nhu cu).
SIGN_CACHE=true
# Chu ky lam moi (phut). SIGN it thay doi -> 360 phut (6h) la du.
SIGN_CACHE_MINUTES=360

# --- Chatbot: MO HINH AI - TUY CHON, MAC DINH TAT ---
# Chon nha cung cap qua LLM_PROVIDER. De TRONG -> chatbot chay thuan rule/intent
# (khong goi AI, khong gui du lieu di dau). LLM chi duoc dung cho cau hoi bot
# CHUA hieu hoac nguoi dung bam "Bao sai"; cau hoi so lieu van do rule-based lo.
#
#   LLM_PROVIDER=local      -> AI NOI BO trong LAN (Ollama / OpenAI-compatible)
#   LLM_PROVIDER=anthropic  -> AI DAM MAY (Claude) - GUI DU LIEU RA NGOAI cong ty
#   (de trong)              -> TAT
LLM_PROVIDER=

# (1) LLM NOI BO (LLM_PROVIDER=local): chi cho phep dia chi TRONG MANG NOI BO
#     (10.x / 192.168.x / 172.16-31.x / ten may LAN). Server TU CHOI neu URL tro
#     ra Internet -> khong gui du lieu ra ngoai. Vi du Ollama ben duoi.
LLM_URL=
# Vi du:  LLM_URL=http://10.0.0.5:11434/api/chat   (OpenAI-compatible: .../v1/chat/completions)

# (2) LLM DAM MAY (LLM_PROVIDER=anthropic): CANH BAO - gui noi dung cau hoi RA
#     NGOAI cong ty (dich vu cong cong). Chi bat khi da co PHE DUYET an ninh.
#     - Bat buoc LLM_ALLOW_PUBLIC=true de xac nhan chu dich gui ra ngoai.
#     - LLM_API_KEY: khoa API (KHONG commit len git).
#     - Can cai SDK: npm i @anthropic-ai/sdk
#     - LLM_REDACT=true (mac dinh): tu dong CHE Part/Serial/Label/so tau truoc khi
#       gui. Moi lan goi deu ghi audit vao logs/llm-cloud-YYYY-MM-DD.log.
LLM_API_KEY=
# Model mac dinh khi de trong: local=qwen2.5:7b, anthropic=Claude (Opus) moi nhat.
LLM_MODEL=
LLM_MAX_TOKENS=600
LLM_TIMEOUT_MS=20000
# Che dinh danh nhay cam truoc khi gui ra dam may (mac dinh BAT). Chi tat khi
# thuc su can va da hieu ro rui ro.
LLM_REDACT=true
# Bat buoc =true de cho phep goi dich vu CONG CONG (LLM dam may, hoac LLM_URL
# ngoai LAN). Mac dinh false = an toan (khong gui du lieu ra ngoai).
LLM_ALLOW_PUBLIC=false

# --- Bao mat trang ADMIN (review log cau hoi chatbot chua hieu) ---
# Chi cac IP nay (VA localhost) moi vao duoc /admin va /api/admin/*. IP khac
# se bi TU CHOI (403) va ghi canh bao vao logs/admin-access-YYYY-MM-DD.log.
# Danh sach ngan cach dau phay. Kiem tra dua tren IP SOCKET that (chong gia mao).
ADMIN_IPS=10.99.89.120

# --- THU MUC FILE SCAN PDF (doi chieu phieu da scan hay chua) ---
# Dung cho tab "Quan ly xuat kho" va tab "Receiving".
#   Picking list : ten file <PICKING_LISTNO_I>-....pdf -> lay phan truoc dau '-'
#                  (cung thu muc nay chua phieu tra <HISTORYNO_I>-....pdf)
#   Receiving    : ten file <VOUCHERNO>.pdf (so NGUYEN ten; VOUCHERNO da bo 'R-')
# Day chi la GIA TRI MAC DINH: may quan tri sua duoc ngay tren trang /admin,
# ket qua luu vao <DATA_DIR>/scan-folders.json va DE HON hai bien nay.
# Tai khoan chay service phai DOC DUOC duong dan UNC (LocalSystem thi khong).
SCAN_PICKING_DIR=\\10.99.7.7\picking list\2026
SCAN_RECEIVING_DIR=\\10.99.7.7\certificates\2026

# --- TOC DO TRUY VAN QUA LINKED SERVER (AMOS) ---
# Thoi gian toi da cho MOT cau truy van (ms). Cu de 60000 hay bao
# "Timeout: Request failed to complete in 60000ms" o cac ky dai.
DB_REQUEST_TIMEOUT_MS=180000
#
# Bien do (so ngay) noi rong khi loc PICKSLIP_BOOKED theo [CREATED_DATE].
# KY BAO CAO VAN TINH THEO PICKSLIP_DATE - cot CREATED_DATE chi dung de CAT BOT
# du lieu ngay tren may chu AMOS cho nhanh. Neu dashboard canh bao "cham bien
# do" thi tang so nay len roi khoi dong lai service.
PICKSLIP_CREATED_PAD_DAYS=60

# --- BAO CAO DINH KY -> TEAMS / SHAREPOINT (phuong an 3) - MAC DINH TAT ---
# ⚠️ Bat len = SO LIEU TONG HOP (KPI + bang chi tiet CSV) duoc gui len cloud
# Microsoft 365. Chi bat khi da chap nhan chinh sach nay.
#
# (1) The KPI vao kenh Teams — dung TEAMS WORKFLOWS (Incoming Webhook cu da bi
#     Microsoft khai tu). Cach lay URL: mo kenh Teams > ... > Workflows >
#     "Post to a channel when a webhook request is received" > copy URL dan vao day.
TEAMS_WEBHOOK_URL=
# (2) Xuat file EXCEL (.xlsx: sheet KPI + sheet Chi tiet TAT) vao thu muc
#     SharePoint/OneDrive dang SYNC tren server -> file tu len thu vien
#     SharePoint, xem duoc tu moi noi. Vd: C:\Users\svc\VAECO\Bao cao TAT - Documents
REPORT_EXPORT_DIR=
# Lich gui: "T2 06:30" (thu 2 6h30 sang) | "T2,T5 06:30" | "CN 18:00" | MON/TUE...
REPORT_SCHEDULE=T2 06:30
# Ky bao cao (danh sach, phay): week = tuan VUA ket thuc | month = thang VUA ket thuc
# "week,month": moi lan chay gui bao cao TUAN; bao cao THANG chi gui 1 lan/thang
# (lan chay dau tien cua thang moi, cho thang vua ket thuc).
REPORT_PERIOD=week,month

# --- Che do DEMO ---
# Bat DEMO_MODE=true de chay thu giao dien voi du lieu MAU (khong can SQL Server).
# Dat false (hoac xoa) khi da co ket noi that.
DEMO_MODE=false
